<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <DefineConstants>$(DefineConstants);RIBBON_IN_FRAMEWORK</DefineConstants>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="PresentationCore\Fonts\*.CompositeFont" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSUI.Tests" />
    <InternalsVisibleTo Include="CSUI.Markup" />
  </ItemGroup>

</Project>
