<GeneratedDashboardView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        x:Class="CSUI.Tests.GeneratedDashboardView"
                        Width="320" Height="200">
    <GeneratedBadgeControl x:Name="PrimaryBadge"
                           Width="{Binding BaseScore, Mode=TwoWay}"
                           Height="{Binding TotalScore}"
                           BadgeLabel="{Binding StatusText}"
                           StaticTier="3" />
    <GeneratedBadgeControl x:Name="IndexedBadge"
                           Width="{Binding Series[1], Mode=TwoWay}"
                           Height="40" />
</GeneratedDashboardView>
