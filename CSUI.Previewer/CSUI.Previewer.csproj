<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>IL2026;IL2050;IL2060;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSUI.Core\CSUI.Core.csproj" />
    <ProjectReference Include="..\CSUI.Markup\CSUI.Markup.csproj" />
  </ItemGroup>

</Project>
