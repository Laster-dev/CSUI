<Project>
  <!-- CSUI Drop-in WPF Replacement MSBuild Targets -->
  <PropertyGroup>
    <_CsuiRootDir>$(MSBuildThisFileDirectory)</_CsuiRootDir>
    <CsuiWpfDropIn Condition="'$(CsuiWpfDropIn)' == ''">true</CsuiWpfDropIn>
    <UseWPF Condition="'$(CsuiWpfDropIn)' == 'true'">false</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectFullPath)' != '$(_CsuiRootDir)CSUI.Core\CSUI.Core.csproj' and '$(MSBuildProjectFullPath)' != '$(_CsuiRootDir)CSUI.Generators\CSUI.Generators.csproj'">
    <ProjectReference Include="$(_CsuiRootDir)CSUI.Core\CSUI.Core.csproj"
                      Condition="Exists('$(_CsuiRootDir)CSUI.Core\CSUI.Core.csproj') and '@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;CSUI.Core&quot;))' == ''" />
    <ProjectReference Include="$(_CsuiRootDir)CSUI.Markup\CSUI.Markup.csproj"
                      Condition="Exists('$(_CsuiRootDir)CSUI.Markup\CSUI.Markup.csproj') and '$(MSBuildProjectFullPath)' != '$(_CsuiRootDir)CSUI.Markup\CSUI.Markup.csproj' and '@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;CSUI.Markup&quot;))' == ''" />
    <ProjectReference Include="$(_CsuiRootDir)CSUI.Generators\CSUI.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="Exists('$(_CsuiRootDir)CSUI.Generators\CSUI.Generators.csproj') and '@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;CSUI.Generators&quot;))' == ''" />
    <ProjectReference Include="$(_CsuiRootDir)CSUI.WebView2\CSUI.WebView2.csproj"
                      Condition="Exists('$(_CsuiRootDir)CSUI.WebView2\CSUI.WebView2.csproj') and '$(MSBuildProjectFullPath)' != '$(_CsuiRootDir)CSUI.WebView2\CSUI.WebView2.csproj' and '@(PackageReference->WithMetadataValue(&quot;Identity&quot;, &quot;Microsoft.Web.WebView2&quot;))' != '' and '@(ProjectReference->WithMetadataValue(&quot;Filename&quot;, &quot;CSUI.WebView2&quot;))' == ''" />
  </ItemGroup>

  <!-- Map standard WPF Page / ApplicationDefinition / Resource items into CSUI compile-time XAML + pack:// resources -->
  <Target Name="_CsuiMapWpfBuildItems"
          BeforeTargets="AssignTargetPaths;PrepareResourceNames;CreateManifestResourceNames;PrepareResources;GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <ItemGroup>
      <!-- Include explicit ApplicationDefinition and Page items -->
      <_CsuiExplicitXaml Include="@(ApplicationDefinition);@(Page)" />
      <!-- Auto-discover **/*.xaml when default items are enabled and not already listed -->
      <_CsuiDiscoveredXaml Include="**\*.xaml"
                           Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin\**;obj\**"
                           Condition="'$(EnableDefaultItems)' == 'true'" />
      <_CsuiAllXamlRaw Include="@(_CsuiExplicitXaml);@(_CsuiDiscoveredXaml)" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_CsuiAllXamlRaw)">
      <Output TaskParameter="Filtered" ItemName="_CsuiDistinctXaml" />
    </RemoveDuplicates>

    <ItemGroup>
      <!-- Avoid re-adding files already explicitly listed in AdditionalFiles -->
      <_CsuiExistingAdditional Include="@(AdditionalFiles)" />
      <AdditionalFiles Include="@(_CsuiDistinctXaml)" Exclude="@(_CsuiExistingAdditional)" />

      <!-- Map WPF <Resource Include="..." /> into <EmbeddedResource> with forward-slash pack:// logical names -->
      <EmbeddedResource Include="@(Resource)" Condition="'@(Resource)' != '' and '%(Resource.Link)' != ''">
        <LogicalName>$([System.String]::new('%(Resource.Link)').Replace('\', '/'))</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(Resource)" Condition="'@(Resource)' != '' and '%(Resource.Link)' == ''">
        <LogicalName>$([System.String]::new('%(RelativeDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- Strip transitive Microsoft.WindowsDesktop.App.WPF & NuGet WebView2.Wpf references -->
  <Target Name="_CsuiStripNuGetWebView2WpfBeforeResolve"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(CsuiWpfDropIn)' == 'true' and '$(MSBuildProjectFullPath)' != '$(_CsuiRootDir)CSUI.WebView2\CSUI.WebView2.csproj' and Exists('$(_CsuiRootDir)CSUI.WebView2\CSUI.WebView2.csproj')">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Target Name="_CsuiStripSystemWpfReferences"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(CsuiWpfDropIn)' == 'true'">
    <ItemGroup>
      <_CsuiWpfRefToRemove Include="@(ReferencePath)"
                           Condition="'%(ReferencePath.Filename)' == 'WindowsBase'
                                   or '%(ReferencePath.Filename)' == 'PresentationCore'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.Aero'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.Aero2'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.AeroLite'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.Classic'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.Luna'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework.Royale'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework-SystemCore'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework-SystemData'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework-SystemDrawing'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework-SystemXml'
                                   or '%(ReferencePath.Filename)' == 'PresentationFramework-SystemXmlLinq'
                                   or '%(ReferencePath.Filename)' == 'PresentationUI'
                                   or '%(ReferencePath.Filename)' == 'ReachFramework'
                                   or '%(ReferencePath.Filename)' == 'System.Xaml'
                                   or '%(ReferencePath.Filename)' == 'UIAutomationProvider'
                                   or '%(ReferencePath.Filename)' == 'UIAutomationTypes'
                                   or '%(ReferencePath.Filename)' == 'UIAutomationClient'
                                   or '%(ReferencePath.Filename)' == 'UIAutomationClientsideProviders'" />
      <ReferencePath Remove="@(_CsuiWpfRefToRemove)" />
    </ItemGroup>
  </Target>
</Project>
