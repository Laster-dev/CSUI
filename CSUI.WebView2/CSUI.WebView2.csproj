<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.Web.WebView2.Wpf</AssemblyName>
    <RootNamespace>Microsoft.Web.WebView2.Wpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSUI.Core\CSUI.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <!-- Strip the NuGet Microsoft.Web.WebView2.Wpf.dll (which targets system PresentationFramework)
       while keeping Microsoft.Web.WebView2.Core.dll and native WebView2Loader.dll. -->
  <Target Name="_StripNuGetWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
